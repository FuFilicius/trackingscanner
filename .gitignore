# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging/build artifacts
build/
dist/
*.egg-info/

# Test/lint/type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration and logs
.env
.env.*
!.env.example
*.log

# Runtime output
test-results/
screenshots/

# Optional local browser packages; keep the directory for Docker COPY.
browsers/*
!browsers/.gitkeep
